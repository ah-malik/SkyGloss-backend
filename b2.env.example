# Backblaze B2 (PDF uploads from admin panel)
# Copy these into SkyGloss-backend/.env (and Railway variables). Never put them in the admin/frontend .env.
# Recommended: a bucket-restricted application key with listBuckets, readFiles, writeFiles, shareFiles.
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your_bucket_name
# Lifetime of signed URLs when the bucket is private (seconds, max 604800 = 7 days)
B2_DOWNLOAD_URL_TTL_SECONDS=604800
