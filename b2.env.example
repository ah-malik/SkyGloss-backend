# Backblaze B2 (admin media library: images, videos, PDFs)
# Copy these into SkyGloss-backend/.env (and Railway variables). Never put them in the admin/frontend .env.
# Recommended: a bucket-restricted application key with
#   listBuckets, listFiles, readFiles, shareFiles, writeFiles, deleteFiles
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your_bucket_name
# Lifetime of "Copy URL" links when the bucket is private (seconds, max 604800 = 7 days)
B2_DOWNLOAD_URL_TTL_SECONDS=604800
# Storage size shown as "total" in the media library (decimal GB; match your B2 storage cap)
B2_STORAGE_LIMIT_GB=10
#
# One-time bucket setup (CORS so the admin panel can upload directly to B2):
#   node scripts/setup-b2-cors.js https://admin.skygloss.com http://localhost:5173 http://localhost:5174 http://localhost:5175
